# Base de datos (ver scripts/db-up.sh)
DATABASE_URL=postgres://apuesta:apuesta@localhost:5432/apuesta

# Puerto del servidor HTTP/Socket.IO
PORT=4000

# Origen permitido de la web para Socket.IO/CORS
WEB_ORIGIN=http://localhost:3000

# Clave para firmar los JWT (cambiar en producción)
JWT_SECRET=dev-insecure-secret-cambiar-en-prod

# Administrador inicial (se crea al arrancar si no hay ninguno)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
